{
  "name": "hospital-management-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-pwa-icons && vite build",
    "preview": "vite preview",
    "generate-pwa-icons": "node scripts/generate-pwa-icons.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:walkthrough": "PLAYWRIGHT_SLOW_MO=400 playwright test e2e/manual-walkthrough.spec.js --headed",
    "test:walkthrough:headless": "playwright test e2e/manual-walkthrough.spec.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.0",
    "vite-plugin-mkcert": "^1.11.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
