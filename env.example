# Frontend Environment Variables
# Copy to .env and fill in values

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API base URL (must be the API host, not this frontend). Used at build time.
# Local:  http://localhost:5000/api
# Prod:   https://st-dominic-hospital-system-backend.vercel.app/api
VITE_API_BASE_URL=https://st-dominic-hospital-system-backend.vercel.app/api
